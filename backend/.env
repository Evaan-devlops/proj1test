AWS_ACCOUNT_KEYS=dev

AWS_ACCOUNT__DEV__ACCESS_KEY_ID=replace_with_access_key_id
AWS_ACCOUNT__DEV__SECRET_ACCESS_KEY=replace_with_secret_access_key
AWS_ACCOUNT__DEV__SESSION_TOKEN=replace_with_session_token_if_any
AWS_ACCOUNT__DEV__REGION=us-east-1

OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
TOKEN_URL=https://auth.example.com/oauth2/token?grant_type=client_credentials
LLM_API=https://llm-gateway.example.com/chatCompletion
LLM_PAYLOAD_MODE=model_messages
LLM_ENGINE=gpt-4o-mini
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=10000
TOKEN_REQUEST_TIMEOUT_SECONDS=30
LLM_REQUEST_TIMEOUT_SECONDS=60
